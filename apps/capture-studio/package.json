{
  "name": "capture-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Capture Studio V1 -- a creator-facing visual shell over FLOW Creative Capture, backed by a small local Studio service (apps/capture-studio/service) that owns SQLite/private-key/filesystem access on the engine's behalf. The browser UI never touches those directly. Not a DAW, not a live recorder.",
  "type": "module",
  "scripts": {
    "generate-fixture": "tsx scripts/generateFixture.ts",
    "dev": "vite",
    "studio-service": "tsx service/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p service/tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p service/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
